{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "language.schema.json",
  "title": "ClimWeb Weather App language file",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "name", "native_name", "cap_feed_url", "fallback_cap_feed_url", "cap_sender_id", "translations"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z]{2,3}$",
      "errorMessage": "must be a 2 or 3 letter lowercase language code like \"sw\""
    },
    "name": { "$ref": "#/definitions/text" },
    "native_name": { "$ref": "#/definitions/text" },
    "cap_feed_url": { "$ref": "#/definitions/feed" },
    "fallback_cap_feed_url": { "$ref": "#/definitions/feed" },
    "cap_sender_id": {
      "type": "string",
      "pattern": "^\\S*$",
      "errorMessage": "must be the <sender> value from your warnings, with no spaces"
    },
    "cap_language_aliases": {
      "type": "array",
      "items": { "$ref": "#/definitions/text" }
    },
    "translations": { "$ref": "#/definitions/translations" }
  },

  "definitions": {
    "text": {
      "type": "string",
      "pattern": "\\S",
      "errorMessage": "must not be empty"
    },
    "feed": {
      "type": "string",
      "pattern": "^(https://[^\\s'\"<>`]+)?$",
      "errorMessage": "must be empty or a full https:// address with no spaces or quotes"
    },
    "translations": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [{ "type": "string" }, { "$ref": "#/definitions/translations" }]
      }
    }
  }
}
